node_modules/
dist/
logs/
/data/*
state.json
*.log

.env
.env.*
!ui/.env.demo

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build cache
*.tsbuildinfo
/*.tgz
/vendor/

# Python bytecode — skills ship .py sources into every Workspace; the Alice
# Harness version fingerprint walks every file in a skill tree, so a stray
# .pyc would both perturb the revision and get copied into Workspaces.
__pycache__/
*.pyc

# Skill-provisioned Python environments live under the user-state root, which
# is the checkout itself when OPENALICE_HOME is pinned there
# (`OPENALICE_HOME=$PWD pnpm dev`). Never inside a skill tree.
/tools/*-venv/

# Test
coverage/

# Claude Code — ignore local config, but track shared dev skills/commands
.claude/*
!.claude/skills/
/.claude/skills/playwright-cli/
.playwright-mcp/
/.playwright-cli/
# Local accessibility snapshot exported by Playwright CLI during UI inspection.
/oa-chat.yaml
# Stray screenshots at repo root (playwright captures, manual screen grabs).
# UI assets live under ui/public/ or ui/src/assets/ — never at the root.
/*.png
/*.jpg
/*.jpeg
packages/ibkr/ref/source/JavaClient/
packages/ibkr/ref/source/cppclient/
packages/ibkr/ref/samples/Java/
packages/ibkr/ref/samples/Cpp/
packages/ibkr/ref/CMakeLists.txt

# Local third-party installer research; keep only the context note tracked.
/docs/reference/install-script/*
!/docs/reference/install-script/README.md

# Turborepo
.turbo/

# Vercel CLI local config (project id, scope) — generated by `vercel link`
.vercel

# Credential sealing key — lands at the user-data root, which is the repo
# root whenever OPENALICE_HOME is pinned here (smoke tests, $PWD escape hatch).
/sealing.key

# Isolated Electron demo UI bundle
/ui/dist-demo/
