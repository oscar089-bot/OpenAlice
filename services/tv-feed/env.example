# TradingView API Configuration
TV_API_PROXY=
TV_API_TIMEOUT_MS=10000
# Max time to wait for a new chart to become ready (symbol loaded / first update)
TV_API_READY_TIMEOUT_MS=30000
# Reconnect: keeps retrying at the ceiling forever instead of giving up
TV_API_RECONNECT_MAX_ATTEMPTS=10
TV_API_RECONNECT_MAX_DELAY_MS=60000

# Initial Subscriptions (JSON array)
SUBSCRIPTIONS=[{"symbol":"BINANCE:BTCUSDT","timeframe":"1"}]

# Backend Integration
BACKEND_ENDPOINT=
BACKEND_API_KEY=
# Backend push reliability
BACKEND_RETRY_ATTEMPTS=3
BACKEND_RETRY_BACKOFF_MS=1000
BACKEND_QUEUE_LIMIT=1000
# true: only final (closed) bars are POSTed; ticks stay WebSocket-only
BACKEND_CLOSED_BARS_ONLY=true

# WebSocket Configuration
WEBSOCKET_PORT=8081
# Bind address. Loopback by default: this service is UNAUTHENTICATED.
# Set 0.0.0.0 only on a VPS/host behind a firewall, and restrict the port there.
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_ENABLED=true

# Metrics
METRICS_PORT=9100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/tv-fetcher.log
DEBUG_PRICES=false
PRICES_LOG_FILE=./logs/prices.log

# Health Monitoring System
HEALTH_CHECK_INTERVAL_MS=60000
HEALTH_STALE_THRESHOLD_MULTIPLIER=3
HEALTH_AUTO_RECOVERY_ENABLED=true
HEALTH_MAX_RECOVERY_ATTEMPTS=3
HEALTH_FULL_RECONNECT_THRESHOLD=3
HEALTH_FULL_RECONNECT_COOLDOWN_MS=600000
HEALTH_API_PORT=8082 